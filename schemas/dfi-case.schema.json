{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OmarArgenes/debugging-for-instances/schemas/dfi-case.schema.json",
  "title": "DFI Case Record",
  "type": "object",
  "required": [
    "caseId",
    "title",
    "problem",
    "hypotheses",
    "tests",
    "status"
  ],
  "properties": {
    "caseId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "investigator": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "stack": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "exploratory",
        "validation",
        "comparative",
        "tracing",
        "isolation",
        "verification",
        "mixed"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved",
        "unresolved"
      ]
    },
    "problem": {
      "type": "object",
      "required": [
        "expected",
        "actual"
      ],
      "properties": {
        "expected": {
          "type": "string"
        },
        "actual": {
          "type": "string"
        },
        "reproduction": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "candidate",
              "retained",
              "weakened",
              "rejected",
              "supported"
            ]
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "procedure",
          "evidence",
          "interpretation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "procedure": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "interpretation": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          }
        }
      }
    },
    "cause": {
      "type": "string"
    },
    "correction": {
      "type": "string"
    },
    "verification": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}